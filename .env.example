# Copy this file to .env and fill in your own values. Never commit .env.

# Full HTTPS Sepolia RPC URL, for example from Alchemy or Infura.
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Test-wallet private key only. Use 64 hex characters, with or without 0x.
PRIVATE_KEY=0xYOUR_64_HEX_CHARACTER_TEST_WALLET_PRIVATE_KEY

# Etherscan API key for verification.
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# Filled after deployment if you want to use scripts/transfer.js.
TIVOX_CONTRACT_ADDRESS=
TRANSFER_TO=
TRANSFER_AMOUNT=10
