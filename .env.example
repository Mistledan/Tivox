# Copy this file to .env and fill in your own values. Never commit .env.

# --- Testnet (Sepolia) ---
# Full HTTPS Sepolia RPC URL, for example from Alchemy or Infura.
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# --- Mainnet (Base L2) ---
# Full HTTPS Base RPC URL (Alchemy, Infura, or a public endpoint).
BASE_RPC_URL=https://mainnet.base.org

# Wallet private key used to deploy and fund the pool. Use 64 hex chars,
# with or without 0x. For Base this must hold real ETH (bridge from Ethereum).
PRIVATE_KEY=0xYOUR_64_HEX_CHARACTER_WALLET_PRIVATE_KEY

# Etherscan / Basescan API key for contract verification.
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# --- Base launch configuration (scripts/launchBase.js) ---
# Community allocation is vested (anti-dump): nothing releases for 30 days,
# then it unlocks linearly to this beneficiary over 180 days.
COMMUNITY_WALLET=0xYOUR_COMMUNITY_WALLET_ADDRESS

# ETH (in ETH units) paired with the token to create the pool. 0.2 ETH is the
# honest hard floor (~$550) — below that the pool is too shallow and bots
# will farm it. Prefer more if you can afford it.
LP_ETH=0.2

# Optional overrides (defaults in parentheses):
# LP_PERCENT=80                 percentage of supply added to the pool (80)
# COMMUNITY_PERCENT=20          percentage vested to the community wallet (20)
# VESTING_ENABLED=true          false = transfer community share directly (true)
# VESTING_CLIFF_DAYS=30         days with zero releases after launch (30)
# VESTING_DURATION_DAYS=180     days of linear unlock after the cliff (180)
# RENOUNCE_OWNERSHIP=true       renounce token ownership after setup (false)
# TVX_CONTRACT_ADDRESS=         existing TVX address to launch against (deploys new if empty)

# --- Testnet transfer helper (scripts/transfer.js) ---
TIVOX_CONTRACT_ADDRESS=
TRANSFER_TO=
TRANSFER_AMOUNT=10