# Copy to social/.env when running locally. Never commit .env.

# --- Content generation (optional) ---
# Leave OPENAI_API_KEY empty to use the built-in templates.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# How many posts per platform per run.
SOCIAL_COUNT=1
# Set to 1 to force a dry run without posting.
SOCIAL_DRY_RUN=0

# --- Telegram (free, easiest) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- X / Twitter (OAuth 1.0a, requires a paid API tier for posting) ---
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# --- YouTube (OAuth 2.0 refresh token + an .mp4 in social/assets/videos) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY_STATUS=private
YOUTUBE_CATEGORY_ID=28

# --- TikTok (Content Posting API; app audit required for public posts) ---
TIKTOK_ACCESS_TOKEN=
TIKTOK_PRIVACY_LEVEL=SELF_ONLY
